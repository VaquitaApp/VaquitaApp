# Configuración del backend — un ambiente = un set de valores (12-factor).
# Dónde vive la config de cada ambiente:
#   dev local : este archivo copiado a server/.env (lo crea scripts/setup.sh)
#   CI/tests  : variables en .github/workflows/node.js.yml
#   staging   : task definition del servicio ECS Express Mode (MONGO_URI → BD vaquitaapp_staging en Atlas)
#   prod      : task definition del servicio ECS Express Mode (MONGO_URI → BD vaquitaapp en Atlas)
# NODE_ENV no se define aquí: la imagen Docker de producción ya lo fija
# (server/Dockerfile, target prod); en dev queda en development por defecto.

PORT=3001
MONGO_URI=mongodb://localhost:27017/vaquitaapp
JWT_SECRET=change_me_generate_with_node_crypto
JWT_EXPIRES_IN=7d

# Email — dev: Mailpit local (sin auth); staging/prod: Brevo SMTP
# (smtp-relay.brevo.com:587 + SMTP_USER/SMTP_PASS de la cuenta Brevo).
# SES queda como opción futura con dominio propio: mismos campos, otros valores.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@vaquitaapp.local
# SMTP_USER=   (solo proveedores reales; si no se define, no se usa auth)
# SMTP_PASS=

# URL del frontend (links en correos) — staging/prod: URL de Amplify
APP_BASE_URL=http://localhost:5173
