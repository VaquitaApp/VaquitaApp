{
  "name": "vaquitaapp-e2e",
  "version": "1.0.0",
  "description": "Pruebas E2E con Puppeteer para VaquitaApp — INF331 Entrega 3",
  "private": true,
  "scripts": {
    "seed": "node seed.js",
    "test": "jest --runInBand --forceExit",
    "test:report": "jest --runInBand --forceExit --verbose 2>&1 | tee reports/e2e-result.txt"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.0",
    "mongoose": "^8.0.0",
    "puppeteer": "^22.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.e2e.test.js"
    ],
    "testTimeout": 60000,
    "reporters": [
      "default"
    ]
  }
}
